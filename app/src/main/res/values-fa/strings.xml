    <string name="app_name">DeviceAtlas</string>
    <string name="foundation_description">ورودی آزمایشی مشخص: ۲، ۴، ۶. این بررسی برای ارتباط با هستهٔ Rust است و سخت‌افزار دستگاه را ارزیابی نمی‌کند.</string>
